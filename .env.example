PORT=5413
DATA_DIR=./data/knowops
# Default: extractive-demo. API secrets are server-side only.
GENERATION_MODE=extractive-demo
MODEL_API_BASE=https://api.example.test/v1
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=45000
# Set all three to use real embeddings. Reingest and publish documents for this index.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
# Set secure cookies when deployed behind HTTPS.
COOKIE_SECURE=false
